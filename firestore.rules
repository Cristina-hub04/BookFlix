rules_version = '2';

// BookFlix security rules.
// Publish them in the Firebase console: Firestore Database > Rules > paste this file > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins have a document in /admins named after their uid (added in the Firebase console).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /admins/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false; // only from the Firebase console
    }

    // The catalog: everyone can browse, only admins can change it.
    match /item/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // readers may save the AI-generated story map or case file the first time a book gets one
        || (signedIn() && onlyChanges(['world']) && !('chapters' in resource.data.get('world', {})))
        || (signedIn() && onlyChanges(['caseFile']) && !('caseFile' in resource.data));

      // One review per reader, stored under their uid.
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if isUser(uid)
          && request.resource.data.userId == uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow delete: if isUser(uid) || isAdmin();
      }
    }

    // Collection-group reads used by the admin dashboard.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    // Community feed on Home: anyone reads, readers post as themselves.
    match /activityFeed/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Each reader's own data: profile, shop (cart, favorites, library), reading progress, My List.
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if isUser(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isUser(uid);
      }
    }

    // Anything else (e.g. the old shared personalList) is closed.
  }
}
